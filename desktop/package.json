{
  "name": "pyc-hermes-desktop",
  "private": true,
  "version": "0.2.1",
  "description": "Minimal Electron shell for the PycHermesAgent Python sidecar (engineering preview)",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pyc.hermes.agent",
    "productName": "PycHermesAgent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
